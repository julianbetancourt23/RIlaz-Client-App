# ==========================================================
# Rilaz Customer Middleware — plantilla de variables
# Copiar como .env y llenar con valores reales.
# El archivo .env NO debe subirse a GitHub.
# ==========================================================

PORT=3001

# ---- Modo de datos ----
# true  = datos simulados (sin SAP) — modo actual de desarrollo/preview
# false = SAP B1 Service Layer real (aún no implementado; ver ../SAP_INTEGRATION.md)
USE_MOCK_SAP=true

# ---- SAP Service Layer (para cuando se conecte de verdad) ----
# Valores reales en rilaz-project\middleware-api\.env (proyecto del técnico).
SAP_BASE_URL=https://192.168.1.30:50000/b1s/v1/
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=

# ---- JWT (generar uno nuevo, NO reutilizar el del backend de técnicos) ----
JWT_SECRET=
JWT_EXPIRATION=30d

# ---- Panel IT ----
# Contraseña del panel de administración (dev por defecto: 000000)
IT_PASSWORD=000000
